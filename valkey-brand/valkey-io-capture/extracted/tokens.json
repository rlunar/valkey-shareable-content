    {
      "selector": "div",
      "type": "hero",
      "x": 0,
      "y": 143,
      "width": 1920,
      "height": 558,
      "heading": "FAST. RELIABLE.",
      "backgroundColor": "#30186E",
      "callsToAction": [
        "GET STARTED"
      ],
      "text": "FAST. RELIABLE. OPEN SOURCE, FOREVER. Valkey is an open source (BSD) high-performance key/value datastore that supports a variety of workloads such as caching, message queues, and can act as a primary database. The project is backed by the Linux Foundation, ensuring it will remain open source forever. GET STARTED",
      "layout": "centered",
      "assetUrls": [
        "https://valkey.io/img/hero-bg.webp"
      ],
      "backgroundImage": "https://valkey.io/img/hero-bg.webp",

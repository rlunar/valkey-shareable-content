{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "doc-page.js",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Play|Open Sans|Cascadia Code|Inter|Source Code Pro))/i]",
        "message": "Font not provided by the design system. Available: Play, Open Sans, Cascadia Code, Inter, Source Code Pro."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|technical-deep-dive|community-highlight|how-to|announcements|events|first-party|third-party|meetup-hackathon)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'technical-deep-dive' | 'community-highlight' | 'how-to' | 'announcements' | 'events' | 'first-party' | 'third-party' | 'meetup-hackathon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|dismissible|onClose|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: children, dismissible, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='Blockquote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|cite|key|ref|className|style|children)$/]",
        "message": "<Blockquote> doesn't accept that prop. Declared props: children, cite."
      },
      {
        "selector": "JSXOpeningElement[name.name='BreadcrumbItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<BreadcrumbItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|as|fullWidth|disabled|iconSrc|iconAlt|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, as, fullWidth, disabled, iconSrc, iconAlt."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:hero|outline|outline-dark|outline-ink|solid|ghost)$/]",
        "message": "<Button> variant must be one of 'hero' | 'outline' | 'outline-dark' | 'outline-ink' | 'solid' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|surface|padding|title|description|actions|iconSrc|iconAlt|raiseOnHover|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, surface, padding, title, description, actions, iconSrc, iconAlt, raiseOnHover."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:light|light-bordered|light-square|dark|indigo|translucent)$/]",
        "message": "<Card> surface must be one of 'light' | 'light-bordered' | 'light-square' | 'dark' | 'indigo' | 'translucent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Card> padding must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|theme|showPrompt|lineNumbers|key|ref|className|style|children)$/]",
        "message": "<CodeBlock> doesn't accept that prop. Declared props: code, theme, showPrompt, lineNumbers."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<CodeBlock> theme must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|emphasis|stickyFirstColumn|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: columns, rows, emphasis, stickyFirstColumn."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute[name.name='emphasis'] > Literal[value!=/^(?:indigo|neutral)$/]",
        "message": "<DataTable> emphasis must be one of 'indigo' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|base|alt|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, base, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:github|slack|linkedin|mail|x|youtube|close|caret|question|bug|users|bulb|shield|book)$/]",
        "message": "<Icon> name must be one of 'github' | 'slack' | 'linkedin' | 'mail' | 'x' | 'youtube' | 'close' | 'caret' | 'question' | 'bug' | 'users' | 'bulb' | 'shield' | 'book'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|width|base|href|clearSpace|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, width, base, href, clearSpace."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:horizontal-color|horizontal-color-light|horizontal-black|horizontal-white|stacked-color|stacked-color-light|stacked-black|stacked-white|icon-periwinkle|icon-black|icon-white)$/]",
        "message": "<Logo> variant must be one of 'horizontal-color' | 'horizontal-color-light' | 'horizontal-black' | 'horizontal-white' | 'stacked-color' | 'stacked-color-light' | 'stacked-black' | 'stacked-white' | 'icon-periwinkle' | 'icon-black' | 'icon-white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ParticipantCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|logoSrc|offering|href|key|ref|className|style|children)$/]",
        "message": "<ParticipantCard> doesn't accept that prop. Declared props: name, logoSrc, offering, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReadMoreLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|key|ref|className|style|children)$/]",
        "message": "<ReadMoreLink> doesn't accept that prop. Declared props: children, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|size|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: label, placeholder, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<SearchInput> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:iconBase|showLegal|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: iconBase, showLegal."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeaderNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|submenu|key|ref|className|style|children)$/]",
        "message": "<SiteHeaderNavItem> doesn't accept that prop. Declared props: label, href, submenu."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],

# Cache-aside pattern flow — Valkey in front of an RDBMS
# Light theme for lavender-background slides (#BCB5E7).
# Render: theme 0, then swap canvas fill #FFFFFF -> #BCB5E7 to blend into slide bg.
direction: right

app: Application {
  shape: person
  style: { fill: "#30176E"; font-color: "#FFFDFA"; stroke: "#30176E" }
}
valkey: Valkey {
  shape: hexagon
  style: { fill: "#6983FF"; font-color: "#1A2026"; stroke: "#30176E"; bold: true }
}
db: RDBMS {
  shape: cylinder
  style: { fill: "#642637"; font-color: "#FFFDFA"; stroke: "#642637" }
}

app -> valkey: "1. GET key" {
  style.stroke: "#30176E"
  style.font-color: "#1A2026"
}
valkey -> app: "2. HIT: return value (microseconds)" {
  style.stroke: "#6983FF"
  style.font-color: "#30176E"
  style.bold: true
}
valkey -> db: "3. MISS: read once" {
  style.stroke: "#642637"
  style.font-color: "#642637"
}
db -> valkey: "4. write-back (SET + TTL)" {
  style.stroke: "#642637"
  style.font-color: "#642637"
  style.stroke-dash: 3
}
